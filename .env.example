# Taiwan Signal — 環境變數範本（F-14）
# 正式值一律設在 Render 環境變數，不要把真實金鑰寫進這個檔或任何 repo 檔案。
# 複製成 .env 僅供本機測試用；.env 已被 .gitignore 排除，不會進版控。

# ── 資料庫 ──
DATABASE_URL=                 # Render Postgres 連線字串；未設時本機用 SQLite

# ── 登入 / 權限 ──
REQUIRE_LOGIN=1               # 1=需 Google 登入（預設）；0=關閉登入牆（僅本機測試）
OWNER_EMAILS=                 # 機主 email，逗號分隔；未設時用程式內建預設
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=               # Cookie 簽名金鑰；未設時由 client secret 衍生
PUBLIC_BASE_URL=              # 例 https://taiwan-signal.onrender.com

# ── 後台第二層密碼（選用，預設關閉）──
ADMIN_AUTH_REQUIRED=0         # 1=啟用後台密碼；需同時設 ADMIN_PASSWORD（至少 8 碼）
ADMIN_PASSWORD=

# ── 帳戶 / 風控 ──
ACCOUNT_BALANCE_TWD=          # 模擬帳戶資金（研究用，非真實券商帳戶）

# ── Telegram 通知 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_FREE_CHANNEL=
TELEGRAM_PAID_CHANNEL=

# ── 每月備份寄信（Gmail SMTP）──
BACKUP_SMTP_HOST=
BACKUP_SMTP_PORT=
BACKUP_SMTP_USER=
BACKUP_SMTP_PASS=             # Gmail 應用程式密碼（16 碼）
BACKUP_EMAIL_TO=

# ── 市場 / 基本面資料來源 ──
FINMIND_TOKEN=
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
FUGLE_API_KEY=
GOOGLE_API_KEY=

# ── 券商（目前未啟用真實下單，僅保留設定位）──
FUBON_ACCOUNT=
FUBON_API_KEY=
FUBON_API_SECRET=

# ── 報告用 LLM（選用，未設時退回規則式摘要）──
LLM_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
REPORT_AI_EFFORT=
